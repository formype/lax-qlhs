rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOptionalString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // 2. Classes Collection
    match /classes/{classId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 3. Students Collection
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 4. Violations Collection
    match /violations/{violationId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 5. Attendance Collection
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 6. Notifications Collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 7. Custom Violations Collection
    match /custom_violations/{id} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 8. Settings Collection
    match /settings/{id} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 9. System Config Collection
    match /system_config/{configId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Fallback for subcollections or general documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
